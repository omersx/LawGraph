# ── Google Gemini ──
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemma-4-31b-it

# ── External Reasoning Model (optional) ──
# If set, the Reasoner node uses this endpoint instead of Gemini
# REASONING_MODEL_URL=https://your-fine-tuned-model-api.com/v1/chat/completions
# REASONING_MODEL_API_KEY=your_key_here

# ── MCP Servers (local stdio) ──
MCP_GOVINFO_SERVER_PATH=../legal-mcp/govinfo-mcp/server.js
MCP_COURTLISTENER_SERVER_PATH=../legal-mcp/courtlistener-mcp/server.js

# ── Server ──
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
